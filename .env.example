# Copy this file to .env and fill in the values. Never commit .env.
# See CONTRIBUTING.md > "Environment and services" for where each value comes from.

# Supabase: Project Settings > API in your Supabase dashboard
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Same values, read by server functions and SSR
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Server only (bypasses RLS). Used to seed the demo accounts on /auth
SUPABASE_SERVICE_ROLE_KEY=

# Firebase: Project settings > General > Your apps > SDK setup and configuration.
# These are public values; the Firestore and Storage rules do the protecting.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=<project-id>.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Set to true to use the local emulators (npm run emulators) instead of the real project
VITE_FIREBASE_EMULATORS=false

# Mapbox: https://account.mapbox.com/access-tokens/
# Public pk. token: renders maps and is the browser fallback for address/route lookups
VITE_MAPBOX_PUBLIC_TOKEN=
# Server-side token for address/route lookups (a secret sk. token, or the same pk. token)
MAPBOX_ACCESS_TOKEN=
