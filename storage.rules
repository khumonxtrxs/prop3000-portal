rules_version = '2';

// Storage rules for the Prop3000 Portal, mirroring the Supabase storage policies.
//
// lead-photos/ — photos attached to a public form submission. Anyone may upload, only staff read.
// job-photos/  — progress photos on a job. Staff upload, job participants read.

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function roles() {
      return firestore.exists(/databases/(default)/documents/user_roles/$(request.auth.uid))
        ? firestore.get(/databases/(default)/documents/user_roles/$(request.auth.uid)).data.roles
        : [];
    }

    function hasRole(role) {
      return signedIn() && role in roles();
    }

    function isStaff() {
      return hasRole('admin') || hasRole('owner') || hasRole('supervisor') || hasRole('agent');
    }

    function isOffice() {
      return hasRole('admin') || hasRole('owner');
    }

    // Images only, 10 MB ceiling. The upload component compresses on the phone first.
    function isAllowedImage() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 10 * 1024 * 1024;
    }

    // Uploads land in dated subfolders, e.g. lead-photos/requests/2026/<uuid>.jpg.
    match /lead-photos/{path=**} {
      allow create: if isAllowedImage();
      allow read: if isStaff();
      allow update: if false;
      allow delete: if isOffice();
    }

    match /job-photos/{jobId}/{fileName} {
      function jobDoc() {
        return firestore.get(/databases/(default)/documents/jobs/$(jobId)).data;
      }

      allow create: if isStaff() && isAllowedImage();
      allow read: if signedIn() && (
        isStaff() || jobDoc().client_id == request.auth.uid
      );
      allow update: if false;
      allow delete: if isStaff();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
